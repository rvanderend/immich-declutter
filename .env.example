TZ=Europe/Amsterdam

# Immich API key with permissions: asset.read, asset.view, album.read, album.create, albumAsset.create
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=
# Only used for the link in Pushover notifications
IMMICH_PUBLIC_URL=https://photos.example.com

# Immich's machine-learning service (CLIP). Not exposed by Immich's default compose file:
# join the Immich network (see compose.yaml) or publish port 3003.
ML_URL=http://immich-machine-learning:3003
# Must match Settings > Machine Learning > Smart Search > CLIP model
CLIP_MODEL=ViT-B-32__openai

# When and what
RUN_AT=03:30
RUN_ON_START=false
CATEGORIES=memes,tiktok,screenshots,receipts
# true = evaluate the whole library (first time is heavy: roughly 1-2 hours per 100k photos);
# already evaluated assets are skipped, so it is cheap afterwards
FULL_SCAN=false
# Only assets that have been in Immich at least this long (thumbnail + OCR must be done)
MIN_AGE_HOURS=3

# Album names (optional)
#ALBUM_MEMES=🧹 Memes & web images
#ALBUM_TIKTOK=🧹 TikTok & Reels
#ALBUM_SCREENSHOTS=🧹 Screenshots
#ALBUM_RECEIPTS=🧾 Receipts & barcodes

# Thresholds (optional; higher = fewer but more certain candidates)
#THRESHOLD_MEME=0.45
#THRESHOLD_MEME_VIDEO=0.6
#THRESHOLD_CAPTION=0.5
#THRESHOLD_SCREEN=0.6
#THRESHOLD_RECEIPT_WITH_OCR=0.3
#THRESHOLD_RECEIPT=0.85
#THRESHOLD_BARCODE=0.75

# Optional
PUSHOVER_TOKEN=
PUSHOVER_USER=
UPTIME_KUMA_PUSH_URL=
DRY_RUN=false
THREADS=4
MAX_ASSETS=0
LOG_LEVEL=INFO
